<view class="page">
  <view class="kicker">Situational English</view>
  <view class="h1">把单词用在对话里</view>
  <view class="muted">{{items.length}} 个场景，完成后都有练习题。</view>
  <view class="chips">
    <button wx:for="{{stages}}" wx:key="*this" class="btn {{stage === item ? 'moss' : 'ghost'}}" data-stage="{{item}}" bindtap="setStage">{{item}}</button>
  </view>
  <view class="grid">
    <view class="cell" wx:for="{{shown}}" wx:key="slug" data-slug="{{item.slug}}" bindtap="open">
      <view class="emoji">{{item.emoji}}</view>
      <view class="title">{{item.title}} · {{item.titleEn}}</view>
      <view class="muted">{{item.description}}</view>
      <view>{{item.stage}} · {{item.lineCount}} 句 · {{item.quizCount}} 题</view>
    </view>
  </view>
</view>
