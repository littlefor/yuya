<view class="page" wx:if="{{item}}">
  <view class="kicker">{{item.stage}} · {{item.titleEn}}</view>
  <view class="h1">{{item.emoji}} {{item.title}}</view>
  <view>{{item.summary}}</view>
  <view class="card">
    <view wx:for="{{item.points}}" wx:key="*this" class="muted">· {{item}}</view>
  </view>
  <view class="card" wx:for="{{item.examples}}" wx:key="en">
    <view class="lemma">{{item.en}}</view>
    <view class="muted">{{item.zh}} · 关注 {{item.highlight}}</view>
    <button class="btn ghost" data-text="{{item.en}}" bindtap="play">听例句</button>
  </view>
  <view class="h1" style="font-size: 34rpx;">即时练习 · {{item.quizzes.length}} 题</view>
  <view class="muted" wx:if="{{finished}}">本次答对 {{correct}} / {{item.quizzes.length}}</view>
  <view class="card" wx:for="{{item.quizzes}}" wx:for-index="qi" wx:key="question">
    <view>{{item.question}}</view>
    <button
      wx:for="{{item.displayOptions}}"
      wx:for-item="opt"
      wx:key="text"
      class="option {{opt.klass}}"
      data-qi="{{qi}}"
      data-oi="{{opt.oi}}"
      bindtap="choose"
    >{{opt.text}}</button>
    <view class="muted" wx:if="{{item.explained}}">{{item.explain}}</view>
  </view>
</view>
<view class="empty" wx:else>加载中…</view>
