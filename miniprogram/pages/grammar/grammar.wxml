<view class="page">
  <view class="kicker">Grammar lab</view>
  <view class="h1">一次只攻一个点</view>
  <view class="muted">{{items.length}} 个专题。</view>
  <view class="chips">
    <button wx:for="{{stages}}" wx:key="*this" class="btn {{stage === item ? 'moss' : 'ghost'}}" data-stage="{{item}}" bindtap="setStage">{{item}}</button>
  </view>
  <view class="grid">
    <view class="cell" wx:for="{{shown}}" wx:key="slug" data-slug="{{item.slug}}" bindtap="open">
      <view class="emoji">{{item.emoji}}</view>
      <view class="title">{{item.title}}</view>
      <view class="muted">{{item.summary}}</view>
      <view>{{item.stage}} · {{item.quizCount}} 题</view>
    </view>
  </view>
</view>
