<view class="page">
  <view class="h1">创建你的语芽账号</view>
  <view class="card">
    <view class="field">
      <text class="field-label">昵称</text>
      <input class="field-input" type="text" value="{{name}}" bindinput="onName" placeholder="怎么称呼你" placeholder-class="field-ph" />
    </view>
    <view class="field">
      <text class="field-label">邮箱</text>
      <input class="field-input" type="text" value="{{email}}" bindinput="onEmail" placeholder="请输入邮箱" placeholder-class="field-ph" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input class="field-input" password value="{{password}}" bindinput="onPassword" placeholder="至少 6 位" placeholder-class="field-ph" confirm-type="done" bindconfirm="onRegister" />
    </view>
    <view wx:if="{{error}}" class="form-error">{{error}}</view>
    <button class="btn moss" bindtap="onRegister" loading="{{loading}}">开始学习</button>
  </view>
</view>
