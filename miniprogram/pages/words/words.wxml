<view class="page">
  <view class="kicker">Thematic vocabulary</view>
  <view class="h1">按主题对照记</view>
  <view class="muted">词库覆盖四级基础、六级进阶和雅思话题。</view>
  <view class="chips">
    <button wx:for="{{exams}}" wx:key="id" class="btn {{exam === item.id ? 'moss' : 'ghost'}}" data-id="{{item.id}}" bindtap="setExam">{{item.label}}</button>
  </view>
  <view class="grid">
    <view class="cell" wx:for="{{shown}}" wx:key="slug" data-slug="{{item.slug}}" bindtap="openGroup" style="border-top: 8rpx solid {{item.color}};">
      <view class="emoji">{{item.emoji}}</view>
      <view class="title">{{item.name}} <text class="muted">{{item.nameEn}}</text></view>
      <view class="muted">{{item.description}}</view>
      <view>{{item.wordCount}} 词 · {{item.examFocus}} · {{item.stage}}</view>
    </view>
  </view>
</view>
