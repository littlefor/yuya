.sheet { max-height: 62vh; }
.word-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 18rpx 12rpx; border-bottom: 1rpx solid rgba(26,38,28,.08);
}
.word-row.on { background: #fff3d6; border-radius: 12rpx; }
.ico { width: 56rpx; font-size: 36rpx; }
.zh { width: 180rpx; }
.en { flex: 1; display: flex; flex-direction: column; }
.lemma { font-weight: 700; color: #c45c26; }
button { margin: 0; }
