<view class="page" wx:if="{{word}}">
  <view class="muted">{{index + 1}} / {{words.length}} · 答对 {{done}}</view>
  <view class="card">
    <view class="emoji">{{word.emoji}}</view>
    <view class="lemma">{{revealed ? word.lemma : "????"}}</view>
    <view class="muted">{{revealed ? word.ipa : "先选意思"}}</view>
    <button class="btn ghost" bindtap="play">听发音</button>
    <button
      wx:for="{{options}}"
      wx:key="text"
      class="option {{item.klass}}"
      data-meaning="{{item.text}}"
      bindtap="answer"
    >{{item.text}}</button>
    <view wx:if="{{revealed}}" class="muted">{{word.example}} — {{word.exampleZh}}</view>
    <view wx:if="{{revealed}}" class="chips">
      <button class="btn warn" data-result="unknown" bindtap="rate">不认识</button>
      <button class="btn ghost" data-result="fuzzy" bindtap="rate">模糊</button>
      <button class="btn moss" data-result="known" bindtap="rate">认识</button>
    </view>
  </view>
</view>
<view class="card" wx:elif="{{loaded}}">
  <view class="h1">本组练完了</view>
  <view>答对 {{done}} / {{words.length}}</view>
  <button class="btn moss" bindtap="back">返回</button>
</view>
<view class="empty" wx:else>加载中…</view>
